# Warehouse (3PL) API — OAuth2 client credentials
WAREHOUSE_BASE_URL=http://localhost:9000/warehouse
WAREHOUSE_CLIENT_ID=local-demo-client
WAREHOUSE_CLIENT_SECRET=local-demo-secret

# Online shop API — API key
SHOP_BASE_URL=http://localhost:9000/shop
SHOP_API_KEY=local-demo-shop-key

# Optional: Slack/Discord-compatible incoming webhook for alerts
ALERT_WEBHOOK_URL=

# Safety guard: a change needs human review when it is >= REVIEW_MIN_UNITS
# AND larger than REVIEW_RATIO x the current shop value
REVIEW_RATIO=0.5
REVIEW_MIN_UNITS=20

REPORTS_DIR=reports

# Mock systems chaos settings
MOCK_RATE_LIMIT_EVERY=7
MOCK_TOKEN_TTL=60
MOCK_FAIL_RATE=0.03
